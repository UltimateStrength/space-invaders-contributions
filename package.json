{
  "name": "space-invaders-contributions",
  "description": "Turns your GitHub contribution graph into a space invaders animation",
  "version": "0.3.1",
  "license": "Unlicense",
  "private": true,
  "repository": "github:UltimateStrength/space-invaders-contributions",
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "24.12.2",
    "dts-bundle-generator": "9.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "type": "tsc",
    "lint": "prettier -c '**/*.{ts,js,json,md,yml,yaml}' '!packages/*/dist/**'",
    "dev:demo": "npm --prefix packages/demo run dev",
    "build:demo": "npm --prefix packages/demo run build",
    "build:action": "npm --prefix packages/action run build",
    "build:lib": "npm --prefix packages/space-invaders-contributions run build",
    "publish:lib": "npm --prefix packages/space-invaders-contributions/dist publish"
  }
}
