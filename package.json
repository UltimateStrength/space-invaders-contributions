{
  "name": "space-invaders-contributions",
  "description": "Turns your GitHub contribution graph into a space invaders animation",
  "version": "1.0.0",
  "private": true,
  "repository": "github:TODO/space-invaders-contributions",
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "24.12.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "type": "tsc",
    "lint": "prettier -c '**/*.{ts,js,json,md,yml,yaml}' '!packages/*/dist/**'",
    "dev:demo": "( cd packages/demo ; npm run dev )",
    "build:demo": "( cd packages/demo ; npm run build )",
    "build:action": "( cd packages/action ; npm run build )",
    "build:lib": "( cd packages/space-invaders-contributions ; npm run build )",
    "publish:lib": "( cd packages/space-invaders-contributions/dist ; npm publish )"
  }
}
